@startuml
title Savr Platform - UML class diagram

hide circle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
left to right direction

skinparam class {
  BackgroundColor #FFF6EB
  BorderColor #7C6A58
  ArrowColor #586A7C
}

skinparam interface {
  BackgroundColor #EEE8FF
  BorderColor #776A9B
  ArrowColor #586A7C
}

skinparam enum {
  BackgroundColor #E8FFD9
  BorderColor #6E9C57
  ArrowColor #586A7C
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
  DELETED
}

enum BusinessStatus {
  PENDING
  ACTIVE
  BLOCKED
  REJECTED
}

enum OfferStatus {
  DRAFT
  AVAILABLE
  RESERVED
  PICKED_UP
  SOLD_OUT
  EXPIRED
  CANCELLED
}

enum OfferCategory {
  BAKERY
  READY_MEAL
  PRODUCE
  GROCERY
  DESSERT
  BEVERAGE
  MIXED
  OTHER
}

enum OrderStatus {
  ACTIVE
  CANCELLED
  PICKED_UP
  NO_SHOW
}

enum NotificationType {
  BUSINESS_STATUS_CHANGED
  OFFER_PUBLISHED
  OFFER_RESERVED
  OFFER_CANCELLED
  RESERVATION_STATUS_CHANGED
  SYSTEM
}

enum SupportConversationMessageRole {
  USER
  ASSISTANT
  TOOL
  SYSTEM
}

class User {
  - id: Long
  - firstName: String
  - lastName: String
  - email: String
  - password: String
  - role: UserRole
  - status: UserStatus
  - createdAt: LocalDateTime
  + isActive(): boolean
  + isAdmin(): boolean
  + isBlocked(): boolean
  + isDeleted(): boolean
  + activate(): void
  + block(): void
  + markDeleted(): void
  + prepareForRegistration(): void
  + prepareForExternalProvision(password: String): void
  + prepareForCreation(): void
}

class Business {
  - id: Long
  - ownerId: Long
  - name: String
  - description: String
  - iconUrl: String
  - status: BusinessStatus
  - ratingAverage: Double
  - ratingCount: Integer
  - createdAt: LocalDateTime
  + isPending(): boolean
  + isActive(): boolean
  + isBlocked(): boolean
  + isRejected(): boolean
  + belongsTo(user: User): boolean
  + canBeManagedBy(user: User): boolean
  + update(data: Business): void
  + approve(): void
  + reject(): void
  + block(): void
  + reopenForReview(): void
  + registerRating(rating: Integer): void
  + normalizedName(): String
  + updateIcon(iconUrl: String): void
  + setAddressCoordinates(latitude: Double, longitude: Double): void
  + prepareForCreation(): void
}

class Address {
  - street: String
  - city: String
  - postalCode: String
  - country: String
  - latitude: Double
  - longitude: Double
}

class Offer {
  - id: Long
  - businessId: Long
  - title: String
  - description: String
  - imageUrl: String
  - category: OfferCategory
  - illustrativeImage: boolean
  - containsAllergens: List
  - mayContainAllergens: List
  - otherAllergenNote: String
  - price: BigDecimal
  - originalPrice: BigDecimal
  - quantityAvailable: Integer
  - status: OfferStatus
  - autoRepeatEnabled: boolean
  - autoRepeatQuantity: Integer
  - autoRepeatPickupStartTime: LocalTime
  - autoRepeatPickupEndTime: LocalTime
  - recurrenceKey: String
  - createdAt: LocalDateTime
  + isAvailable(): boolean
  + isManagedState(): boolean
  + belongsTo(business: Business): boolean
  + publish(business: Business): void
  + markReserved(): void
  + reserveQuantity(quantity: int): void
  + reopenAfterReservationCancellation(): void
  + restoreQuantity(quantity: int): void
  + markPickedUp(): void
  + markSoldOut(): void
  + expire(): void
  + cancel(): void
  + update(data: Offer): void
  + normalizedTitle(): String
  + setPickupLocationCoordinates(latitude: Double, longitude: Double): void
  + prepareForCreation(): void
  + createRepeatedOccurrenceFor(date: LocalDate): Offer
}

class OfferItem {
  - name: String
  - quantity: Integer
}

class PickupLocation {
  - note: String
}

class PickupTimeWindow {
  - from: LocalDateTime
  - to: LocalDateTime
}

class Order {
  - id: Long
  - businessId: Long
  - userId: Long
  - businessName: String
  - status: OrderStatus
  - createdAt: LocalDateTime
  - cancelledAt: LocalDateTime
  + belongsTo(user: User): boolean
  + isPaid(): boolean
  + canBeManagedBy(user: User, business: Business): boolean
  + prepareForCreation(): void
  + markPaid(...): void
  + markPickedUp(...): void
  + markNoShow(...): void
}

class OrderItem {
  - offerId: Long
  - quantity: Integer
  - title: String
  - imageUrl: String
  - unitPrice: BigDecimal
}

class OrderPayment {
  - paidByUserId: Long
  - amount: BigDecimal
  - currency: String
  - cardHolderName: String
  - cardLast4: String
  - providerReference: String
  - pickupToken: String
  - paidAt: LocalDateTime
  - transferredToBusinessAt: LocalDateTime
  - transferReference: String
  + prepareForCreation(): void
  + markTransferredToBusiness(...): void
}

class OrderPickupConfirmation {
  - confirmedByUserId: Long
  - confirmedAt: LocalDateTime
  + prepareForCreation(): void
}

class Review {
  - id: Long
  - reservationId: Long
  - businessId: Long
  - userId: Long
  - rating: Integer
  - comment: String
  - createdAt: LocalDateTime
  + prepareForCreation(): void
}

class Notification {
  - id: Long
  - userId: Long
  - type: NotificationType
  - title: String
  - message: String
  - createdAt: LocalDateTime
  - readAt: LocalDateTime
  + isRead(): boolean
  + markAsRead(): void
  + belongsTo(user: User): boolean
  + prepareForCreation(): void
}

class SupportConversation {
  - id: Long
  - publicId: String
  - userId: Long
  - sourcePage: String
  - locale: String
  - createdAt: LocalDateTime
  - updatedAt: LocalDateTime
  + refreshMetadata(...): void
  + touch(): void
  + prepareForCreation(): void
}

class SupportConversationMessage {
  - id: Long
  - conversationId: Long
  - role: SupportConversationMessageRole
  - content: String
  - createdAt: LocalDateTime
  + prepareForCreation(): void
}

interface UserRepository {
  + findByEmail(email: String)
  + save(user: User)
}

interface BusinessRepository {
  + findById(id: Long)
  + save(business: Business)
}

interface OfferRepository {
  + findById(id: Long)
  + save(offer: Offer)
}

interface OrderRepository {
  + findById(id: Long)
  + save(order: Order)
}

interface ReviewRepository {
  + findByReservationId(id: Long)
  + save(review: Review)
}

interface NotificationRepository {
  + findAllByUserId(userId: Long)
  + save(notification: Notification)
}

User --> UserRole : role
User --> UserStatus : status
Business --> BusinessStatus : status
Offer --> OfferStatus : status
Order --> OrderStatus : status
Notification --> NotificationType : type

User "1" <-- "0..*" Business : owns
Business "1" *-- "1" Address
Business "1" --> "0..*" Offer : publishes

Offer "1" *-- "1..*" OfferItem
Offer "1" *-- "1" PickupLocation
PickupLocation "1" *-- "1" Address
Offer "1" *-- "1" PickupTimeWindow

User "1" --> "0..*" Order : creates
Business "1" --> "0..*" Order : fulfills
Order "1" *-- "1" OrderItem
Order "1" *-- "1" PickupLocation
Order "1" *-- "1" PickupTimeWindow
Order "1" *-- "0..1" OrderPayment
Order "1" *-- "0..1" OrderPickupConfirmation

Review "0..*" --> "1" Order
Review "0..*" --> "1" Business
Review "0..*" --> "1" User

Notification "0..*" --> "1" User : delivered to
SupportConversation "0..*" --> "0..1" User : started by
SupportConversation "1" --> "0..*" SupportConversationMessage : contains

UserRepository ..> User
BusinessRepository ..> Business
OfferRepository ..> Offer
OrderRepository ..> Order
ReviewRepository ..> Review
NotificationRepository ..> Notification

User -[hidden]- Business
Business -[hidden]- Offer
Offer -[hidden]- Order
Order -[hidden]- Review

Address -[hidden]- Business
OfferItem -[hidden]- PickupLocation
PickupLocation -[hidden]- PickupTimeWindow
OrderItem -[hidden]- OrderPayment
OrderPayment -[hidden]- OrderPickupConfirmation

SupportConversation -[hidden]- User
Notification -[hidden]- Order

UserRepository -[hidden]- BusinessRepository
BusinessRepository -[hidden]- OfferRepository
OfferRepository -[hidden]- OrderRepository
OrderRepository -[hidden]- ReviewRepository
ReviewRepository -[hidden]- NotificationRepository

@enduml
